DUR_API_KEY=
# 서버 기동·약 함께먹기 검사 때 식약처 DUR을 자동으로 받습니다.
DUR_AUTO_SYNC=true
# 기동 시 전체 동기화 페이지 수. all 이면 전량(오래 걸림).
DUR_BOOTSTRAP_MAX_PAGES=20
GEMINI_API_KEY=
MEDICATION_FEATURE_BASE_URL=
MEDICATION_FEATURE_TIMEOUT_SECONDS=10
GEMINI_MODEL=gemini-2.5-flash

# 식약처 의약품 제품 허가정보 (DrugPrdtPrmsnInfoService07)
MFDS_DRUG_PERMISSION_API_KEY=
MFDS_DRUG_PERMISSION_BASE_URL=https://apis.data.go.kr/1471000/DrugPrdtPrmsnInfoService07
MFDS_DRUG_PERMISSION_LIST_PATH=/getDrugPrdtPrmsnInq07
MFDS_DRUG_PERMISSION_DETAIL_PATH=/getDrugPrdtPrmsnDtlInq06

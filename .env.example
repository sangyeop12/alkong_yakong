# 네이버 CLOVA OCR (General/Document OCR)
# 콘솔에서 발급: Invoke URL + Secret Key
CLOVA_OCR_API_URL=
CLOVA_OCR_SECRET_KEY=
CLOVA_OCR_ENABLED=false

# 회원 전체 목록(GET /api/v1/users)을 여는 운영자 열쇠.
